# Database Connection (Supabase)
# Ambil dari: Supabase Dashboard → Settings → Database → Connection string → URI
# Gunakan mode "Transaction" (port 6543) untuk pooling, atau "Session" (port 5432) untuk Drizzle migrations
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Untuk db:push / db:generate (Drizzle Kit butuh direct connection, bukan pooler)
# Gunakan port 5432 (direct connection) bukan 6543 (pooler)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Better Auth Configuration
BETTER_AUTH_SECRET=your-random-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
